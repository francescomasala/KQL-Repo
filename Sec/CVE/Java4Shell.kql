DeviceTvmSoftwareVulnerabilities
| where CveId == "CVE-2026-114938"
| summarize
    DeviceName = take_any(DeviceName),
    OSPlatform = take_any(OSPlatform),
    SoftwareNames = make_set(SoftwareName),
    SoftwareVersions = make_set(SoftwareVersion),
    RecommendedUpdates = make_set(RecommendedSecurityUpdate)
    by DeviceId
| order by DeviceName asc
